{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AxMusic",
  "version": "0.0.3",
  "identifier": "com.axmusic.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AxMusic",
        "width": 1440,
        "height": 900,
        "minWidth": 1440,
        "minHeight": 900,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "category": "Music",
    "shortDescription": "Local music player with library management",
    "longDescription": "AxMusic — Windows local music player with built-in library management (tags, covers, lyrics, organize)."
  }
}
